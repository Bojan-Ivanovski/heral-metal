---
import { copy, contactEmail } from '../../data/site';
import type { Language } from '../../lib/routes';
import PageHeading from '../ui/PageHeading.astro';
interface Props { lang: Language }
const { lang } = Astro.props;
const c = copy[lang];
---
<article class="container standard-page privacy-page"><PageHeading eyebrow={`HERAL METAL / ${c.privacy}`} title={c.privacyTitle} description={c.privacyIntro} />
  {c.privacySections.map(([title, description]) => <section><h2>{title}</h2><p>{description}</p></section>)}
  <p><a href={`mailto:${contactEmail}`}>{contactEmail}</a></p><p><a href="https://web3forms.com/privacy" target="_blank" rel="noopener noreferrer">Web3Forms — {c.privacy}</a> · <a href="https://docs.github.com/en/site-policy/privacy-policies/github-general-privacy-statement" target="_blank" rel="noopener noreferrer">GitHub — {c.privacy}</a></p>
</article>
