---
import Arrow from './Arrow.astro';
interface Props { href: string; outline?: boolean; class?: string }
const { href, outline = false, class: className = '' } = Astro.props;
---
<a href={href} class:list={['button', { 'button-outline': outline }, className]}><slot /><Arrow variant={outline ? 'blue' : 'white'} /></a>
